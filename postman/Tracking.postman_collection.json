      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('shipment exists',()=>pm.response.to.have.status(200));",
              "const base=pm.environment.get('baseUrl'),code=pm.collectionVariables.get('concurrentCode'),token=pm.collectionVariables.get('operatorToken');",
              "const names=['Concurrent A','Concurrent B'];",
              "const send=(status,locationText)=>new Promise((resolve,reject)=>pm.sendRequest({url:base+'/tracking/'+code+'/status',method:'PUT',header:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({status,locationText})}},(error,response)=>error?reject(error):resolve({status:response.code,body:response.json(),locationText})));",
              "Promise.all([send('IN_TRANSIT',names[0]),send('TRANSFERRED',names[1])]).then(results=>{pm.collectionVariables.set('concurrentAccepted',JSON.stringify(results.filter(x=>x.status===202).map(x=>x.locationText)));pm.test('concurrent responses are accepted or rejected transition',()=>{results.forEach(x=>pm.expect([202,409,422]).to.include(x.status));pm.expect(results.some(x=>x.status===202)).to.be.true;});}).catch(e=>pm.test('concurrent requests completed',()=>{throw e;}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Wait for concurrent history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tracking/{{concurrentCode}}/historico?limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('concurrentDeadline'))pm.collectionVariables.set('concurrentDeadline',Date.now()+15000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('history 200',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json(),accepted=JSON.parse(pm.collectionVariables.get('concurrentAccepted')||'[]');",
              "const counts=accepted.map(name=>b.data.filter(x=>x.locationText===name).length);",
              "if(counts.some(n=>n!==1)&&Date.now()<Number(pm.collectionVariables.get('concurrentDeadline'))){pm.execution.setNextRequest('Wait for concurrent history');}else{pm.test('one occurrence per accepted status, without loss',()=>counts.forEach(n=>pm.expect(n).to.eql(1)));}"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete concurrent shipment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tracking/{{concurrentCode}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete shipment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tracking/{{cargoCode}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
