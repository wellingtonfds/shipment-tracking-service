# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database (MSSQL Server 2022 - docker)
# Nunca commite a senha real. Copie este arquivo para .env e preencha.
DATABASE_URL="sqlserver://localhost:1433;database=appdb;user=sa;password=SUA_SENHA_FORTE;encrypt=true;trustServerCertificate=true"
# Mesma senha do .env local (nao comite a real)
MSSQL_SA_PASSWORD=SUA_SENHA_FORTE

# Auth (JWT)
# Segredo de assinatura dos tokens. Gere com: openssl rand -base64 32
JWT_SECRET=TROCAR_POR_SEGREDO_FORTE
# Tempo de vida do token (s, m, h, d). Default: 8h
JWT_EXPIRES_IN=8h

# Tracking assíncrono (opcional no desenvolvimento)
TRACKING_QUEUE_ENABLED=true
TRACKING_WORKER_ROLE=true
TRACKING_DISPATCHER_ROLE=true
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_TLS=false
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=shipment-tracking-tests/1.0 (contato@empresa.com)
GEOCODE_RATE_LIMIT=1
GEOCODER_CACHE_TTL_SECONDS=2592000
GEOCODER_CIRCUIT_FAILURES=5
GEOCODER_CIRCUIT_COOLDOWN_MS=30000
TRACKING_RETRY_WINDOW_MS=86400000
DLQ_REPLAY_INTERVAL_MS=86400000
