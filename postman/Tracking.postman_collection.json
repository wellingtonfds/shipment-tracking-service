    {
      "name": "Wait for first status history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tracking/{{cargoCode}}/historico?limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('waitDeadline'))pm.collectionVariables.set('waitDeadline',Date.now()+15000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('history 200',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();const events=b.data.filter(x=>x.locationText===pm.collectionVariables.get('checkpoint'));",
              "if(events.length!==1){if(Date.now()<Number(pm.collectionVariables.get('waitDeadline'))){pm.execution.setNextRequest('Wait for first status history');}else{pm.test('status event processed once',()=>pm.expect(events.length).to.eql(1));}}else{pm.test('normalized status and history',()=>{pm.expect(events[0].status).to.eql('IN_TRANSIT');pm.expect(b.data.some(x=>x.status==='CREATED')).to.be.true;});}"
            ]
          }
        }
      ]
    },
