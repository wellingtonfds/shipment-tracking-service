{
  "info": {
    "_postman_id": "7f2a1c48-9d5e-4c3a-8b1e-customers1",
    "name": "src-backend — Customers",
    "description": "CRUD of customers from the src-backend API.\n\n- Base: `{{baseUrl}}` (default `http://localhost:3000/api/v1`)\n- Dados do POST são gerados com as variáveis dinâmicas Faker do Postman (`{{$randomFullName}}`, `{{$randomEmail}}`, etc.) — each run generates a different customer\n- The POST stores the created `id` in `{{customerId}}`, usado pelos requests de leitura/atualização/remoção\n- Ordem sugerida (Runner): Lista → Criar → Detalhar → Atualizar → Remover",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "generatedEmail", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1", "description": "Página (começa em 1)" },
                { "key": "limit", "value": "10", "description": "Itens por página (1-100)" }
              ]
            },
            "description": "Lists customers with pagination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('responds in less than 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "pm.test('data is an array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('pagination meta present', () => pm.expect(body.meta).to.have.property('totalPages'));",
                  "pm.test('customer fields are correct', () => {",
                  "  if (body.data.length > 0) {",
                  "    pm.expect(body.data[0]).to.have.all.keys(['id', 'name', 'email', 'phone', 'address', 'createdAt', 'updatedAt']);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"phone\": \"{{$randomPhoneNumber}}\",\n  \"address\": \"{{$randomStreetAddress}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            },
            "description": "Creates a new customer. Data generated by Postman Faker (dynamic variables) — each run sends different and realistic values."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('responds in less than 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const body = pm.response.json();",
                  "pm.test('customer created with id', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.test('persisted fields', () => {",
                  "  pm.expect(body).to.have.property('name');",
                  "  pm.expect(body.email).to.contain('@');",
                  "  pm.expect(body).to.have.property('phone');",
                  "  pm.expect(body).to.have.property('address');",
                  "});",
                  "pm.collectionVariables.set('customerId', body.id);",
                  "pm.collectionVariables.set('generatedEmail', body.email);",
                  "console.log('customerId salvo:', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            },
            "description": "Details of the customer created by the previous request (uses `{{customerId}}`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id matches created', () => pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('customerId')));",
                  "pm.test('email matches created', () => pm.expect(body.email).to.eql(pm.collectionVariables.get('generatedEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"phone\": \"{{$randomPhoneNumber}}\",\n  \"address\": \"{{$randomStreetAddress}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            },
            "description": "Partial update: name/phone/address regenerated by Faker; email is kept (not sent)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('email was not changed', () => pm.expect(body.email).to.eql(pm.collectionVariables.get('generatedEmail')));",
                  "pm.test('updatedAt >= createdAt', () => pm.expect(new Date(body.updatedAt) >= new Date(body.createdAt)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            },
            "description": "Removes the customer created in this run (responds 204 with no body)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204 (no body)', () => pm.response.to.have.status(204));",
                  "pm.test('get now returns 404', async () => {",
                  "  const resposta = await pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/customers/' + pm.collectionVariables.get('customerId'));",
                  "  pm.expect(resposta.status).to.eql(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing customer (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/999999",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "999999"]
            },
            "description": "Error scenario: missing customer must respond 404 com `code: CUSTOMER_NOT_FOUND`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('code CUSTOMER_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('CUSTOMER_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"{{generatedEmail}}\",\n  \"phone\": \"{{$randomPhoneNumber}}\",\n  \"address\": \"{{$randomStreetAddress}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            },
            "description": "Error scenario: tries to recreate the customer with the email already used in this run (`{{generatedEmail}}`). Deve responder 409 `CUSTOMER_EMAIL_IN_USE`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code CUSTOMER_EMAIL_IN_USE', () => pm.expect(pm.response.json().code).to.eql('CUSTOMER_EMAIL_IN_USE'));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Customers routes. Run in order: the last two requests are error scenarios and depend on a successful POST first."
    }
  ]
}
