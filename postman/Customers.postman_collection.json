{
  "info": {
    "name": "Customers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{seedPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "const token = pm.response.json().token;",
              "pm.test('JWT returned', () => pm.expect(token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('adminToken', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login operator",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{operatorEmail}}\", \"password\": \"{{seedPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "const token = pm.response.json().token;",
              "pm.test('JWT returned', () => pm.expect(token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('operatorToken', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Operator denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 FORBIDDEN', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().code).to.eql('FORBIDDEN'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "List customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes?page=1&limit=10",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json(); pm.test('pagination',()=>{pm.expect(b.data).to.be.an('array');pm.expect(b.meta).to.include({page:1,limit:10});});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"{{name}}\", \"email\": \"{{email}}\", \"phone\": \"{{phone}}\", \"address\": \"{{address}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('name',pm.variables.replaceIn('{{$randomFullName}}'));",
              "pm.collectionVariables.set('email',pm.variables.replaceIn('{{$randomEmail}}').toLowerCase());",
              "pm.collectionVariables.set('phone',pm.variables.replaceIn('{{$randomPhoneNumber}}'));",
              "pm.collectionVariables.set('address',pm.variables.replaceIn('{{$randomStreetAddress}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201',()=>pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.test('created customer',()=>{pm.expect(b.id).to.be.a('number');pm.expect(b.email).to.eql(pm.collectionVariables.get('email'));});",
              "pm.collectionVariables.set('customerId',b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get customer",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes/{{customerId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();pm.test('same customer',()=>{pm.expect(b.id).to.eql(Number(pm.collectionVariables.get('customerId')));pm.expect(b.email).to.eql(pm.collectionVariables.get('email'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Another Customer\", \"email\": \"{{email}}\", \"phone\": \"{{phone}}\", \"address\": \"{{address}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 duplicate',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().code).to.eql('CUSTOMER_EMAIL_IN_USE');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"X\", \"email\": \"invalid\", \"phone\": \"1\", \"address\": \"\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 validation',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update customer",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes/{{customerId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"phone\": \"{{newPhone}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('newPhone',pm.variables.replaceIn('{{$randomPhoneNumber}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('updated',()=>{const b=pm.response.json();pm.expect(b.phone).to.eql(pm.collectionVariables.get('newPhone'));pm.expect(b.email).to.eql(pm.collectionVariables.get('email'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete customer",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/clientes/{{customerId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted customer missing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes/{{customerId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404',()=>{pm.response.to.have.status(404);pm.expect(pm.response.json().code).to.eql('CUSTOMER_NOT_FOUND');});"
            ]
          }
        }
      ]
    }
  ]
}
