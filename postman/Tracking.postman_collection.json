    {
      "name": "Create shipment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tracking",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operatorToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cargoCode\": \"{{cargoCode}}\", \"originCity\": \"{{originCity}}\", \"originCountry\": \"Brasil\", \"destinationCity\": \"{{destinationCity}}\", \"destinationCountry\": \"Brasil\", \"departureDate\": \"{{departureDate}}\", \"estimatedDeliveryDate\": \"{{estimatedDeliveryDate}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code='pm'+Date.now().toString(36)+pm.variables.replaceIn('{{$randomInt}}').slice(0,5);",
              "pm.collectionVariables.set('cargoCode',code);",
              "pm.collectionVariables.set('originCity',pm.variables.replaceIn('{{$randomCity}}'));",
              "pm.collectionVariables.set('destinationCity',pm.variables.replaceIn('{{$randomCity}}'));",
              "pm.collectionVariables.set('departureDate',new Date(Date.now()+86400000).toISOString());",
              "pm.collectionVariables.set('estimatedDeliveryDate',new Date(Date.now()+8*86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201',()=>pm.response.to.have.status(201));",
              "const b=pm.response.json();pm.test('created and scoped',()=>{pm.expect(b.cargoCode).to.eql(pm.collectionVariables.get('cargoCode').toUpperCase());pm.expect(b.status).to.eql('CREATED');pm.expect(b.customerId).to.eql(Number(pm.collectionVariables.get('customerId')));pm.expect(b.handledById).to.eql(Number(pm.collectionVariables.get('operatorId')));});"
            ]
          }
        }
      ]
    },
