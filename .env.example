# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database (MSSQL Server 2022 - docker)
# Nunca commite a senha real. Copie este arquivo para .env e preencha.
DATABASE_URL="sqlserver://localhost:1433;database=appdb;user=sa;password=SUA_SENHA_FORTE;encrypt=true;trustServerCertificate=true"
# Mesma senha do .env local (nao comite a real)
MSSQL_SA_PASSWORD=SUA_SENHA_FORTE

# Auth (JWT)
# Segredo de assinatura dos tokens. Gere com: openssl rand -base64 32
JWT_SECRET=TROCAR_POR_SEGREDO_FORTE
# Tempo de vida do token (s, m, h, d). Default: 8h
JWT_EXPIRES_IN=8h
