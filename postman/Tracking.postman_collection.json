    {
      "name": "Combined filters and ordering",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tracking?status=CREATED&idCliente={{customerId}}&idOperador={{operatorId}}&embarqueDe={{departureFrom}}&embarqueAte={{departureTo}}&entregaDe={{estimatedFrom}}&entregaAte={{estimatedTo}}&orderBy=departureDate&order=asc&page=1&limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=new Date(pm.collectionVariables.get('departureDate')).getTime(),e=new Date(pm.collectionVariables.get('estimatedDeliveryDate')).getTime();",
              "pm.collectionVariables.set('departureFrom',new Date(d-3600000).toISOString());pm.collectionVariables.set('departureTo',new Date(d+3600000).toISOString());pm.collectionVariables.set('estimatedFrom',new Date(e-3600000).toISOString());pm.collectionVariables.set('estimatedTo',new Date(e+3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();pm.test('filters',()=>{pm.expect(b.data.some(x=>x.cargoCode===pm.collectionVariables.get('cargoCode').toUpperCase())).to.be.true;b.data.forEach(x=>{pm.expect(x.status).to.eql('CREATED');pm.expect(x.customerId).to.eql(Number(pm.collectionVariables.get('customerId')));pm.expect(x.handledById).to.eql(Number(pm.collectionVariables.get('operatorId')));});for(let i=1;i<b.data.length;i++)pm.expect(b.data[i].departureDate>=b.data[i-1].departureDate).to.be.true;});"
            ]
          }
        }
      ]
    },
